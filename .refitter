{
  "openApiPath": "./container-api.json",
  "namespace": "ProductsupConnector.ContainerApi",
  "naming": {
    "useOpenApiTitle": false,
    "interfaceName": "ContainerApi"
  },
  "generateContracts": true,
  "generateXmlDocCodeComments": true,
  "generateStatusCodeComments": true,
  "addAutoGeneratedHeader": true,
  "addAcceptHeaders": true,
  "returnIApiResponse": false,
  "useCancellationTokens": true,
  "generateDeprecatedOperations": false,
  "immutableRecords": true,
  "trimUnusedSchema": true,
  "typeAccessibility": "Public",
  "outputFolder": "./src/ProductsupConnector/ContainerApi",
  "outputFilename": "ContainerApi.cs",
  "responseTypeOverride": {
    "stream_from_bucket": "System.IO.Stream",
    "run_storage_stream_unspecified_file": "System.IO.Stream"
  }
}
